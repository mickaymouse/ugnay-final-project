<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_dark">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- TITLE -->
        <TextView
            android:id="@+id/tvProfileTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Official Profile"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="@color/text_white" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Barangay Official Digital ID"
            android:textColor="@color/text_secondary"
            android:layout_marginTop="4dp" />

        <!-- DIGITAL ID CARD -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@color/card_background"
            android:padding="16dp"
            android:layout_marginTop="16dp"
            android:elevation="6dp">

            <!-- PROFILE IMAGE PLACEHOLDER -->
            <ImageView
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:src="@android:drawable/sym_def_app_icon"
                android:layout_gravity="center"
                android:background="@android:color/darker_gray"
                android:padding="10dp"/>

            <!-- NAME -->
            <TextView
                android:id="@+id/tvOfficialName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Juan Dela Cruz"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@color/text_white"
                android:layout_gravity="center"
                android:layout_marginTop="10dp"/>

            <!-- POSITION -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Barangay Captain"
                android:textColor="@color/brgy_yellow"
                android:layout_gravity="center"
                android:layout_marginTop="4dp"/>

            <!-- INFO ROWS -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📍 Barangay San Isidro"
                android:textColor="@color/text_secondary"
                android:layout_marginTop="12dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📞 0912-345-6789"
                android:textColor="@color/text_secondary"
                android:layout_marginTop="4dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🆔 OFFICIAL ID: BRGY-001"
                android:textColor="@color/text_secondary"
                android:layout_marginTop="4dp"/>

        </LinearLayout>

        <!-- SEPARATOR -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/text_secondary"
            android:alpha="0.3"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="16dp"/>

        <!-- SECTION TITLE -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Admin Actions"
            android:textColor="@color/brgy_yellow"
            android:textStyle="bold"
            android:textSize="16sp" />

        <!-- BUTTONS -->
        <Button
            android:id="@+id/btnManageResidents"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="Manage Residents"
            android:layout_marginTop="12dp"
            android:backgroundTint="@color/brgy_blue"
            android:textColor="@color/text_white" />

        <Button
            android:id="@+id/btnManageOfficials"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="Manage Officials"
            android:layout_marginTop="8dp"
            android:backgroundTint="@color/brgy_blue"
            android:textColor="@color/text_white" />

        <Button
            android:id="@+id/btnManageProfile"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="Manage My Profile"
            android:layout_marginTop="8dp"
            android:backgroundTint="@color/brgy_blue"
            android:textColor="@color/text_white" />

        <!-- SEPARATOR -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/text_secondary"
            android:alpha="0.3"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="16dp"/>

        <!-- LOGOUT -->
        <Button
            android:id="@+id/btnLogout"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="Logout"
            android:backgroundTint="@android:color/holo_red_dark"
            android:textColor="@color/text_white" />

    </LinearLayout>
</ScrollView>