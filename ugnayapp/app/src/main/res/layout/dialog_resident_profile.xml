<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="16dp"
    app:cardBackgroundColor="@color/card_background"
    app:cardCornerRadius="28dp"
    app:cardElevation="12dp"
    app:strokeWidth="1dp"
    app:strokeColor="#1AFFFFFF">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Header Area with slight background contrast -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="24dp"
            android:background="#08FFFFFF">

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cv_photo_container"
                android:layout_width="72dp"
                android:layout_height="72dp"
                app:cardCornerRadius="36dp"
                app:cardElevation="2dp"
                app:strokeColor="@color/brgy_blue"
                app:strokeWidth="2dp">

                <ImageView
                    android:id="@+id/iv_resident_photo"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:src="@drawable/ic_person"
                    app:tint="@color/brgy_blue"
                    android:contentDescription="Resident Photo" />
            </com.google.android.material.card.MaterialCardView>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_toEndOf="@id/cv_photo_container"
                android:layout_toStartOf="@id/btnClose"
                android:layout_centerVertical="true"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="8dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvProfileName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/poppins_bold"
                    android:text="Juan Dela Cruz"
                    android:textColor="@color/text_white"
                    android:textSize="20sp"
                    android:lineSpacingExtra="-2sp"/>

                <TextView
                    android:id="@+id/tvProfileType"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/poppins_semibold"
                    android:text="Verified Resident"
                    android:textColor="@color/brgy_blue"
                    android:textSize="12sp"
                    android:textAllCaps="true"
                    android:letterSpacing="0.05"
                    android:layout_marginTop="2dp"/>
            </LinearLayout>

            <ImageButton
                android:id="@+id/btnClose"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@android:drawable/ic_menu_close_clear_cancel"
                app:tint="@color/text_secondary"
                android:contentDescription="Close Dialog" />
        </RelativeLayout>

        <!-- Pager Content -->
        <androidx.viewpager2.widget.ViewPager2
            android:id="@+id/viewPagerProfile"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="420dp" />

        <!-- Fixed Indicator at the bottom -->
        <com.google.android.material.tabs.TabLayout
            android:id="@+id/tabLayoutIndicator"
            android:layout_width="match_parent"
            android:layout_height="24dp"
            android:layout_marginBottom="16dp"
            app:tabBackground="@drawable/tab_selector"
            app:tabGravity="center"
            app:tabIndicatorHeight="0dp"
            app:tabMaxWidth="24dp"
            app:tabPaddingStart="4dp"
            app:tabPaddingEnd="4dp"
            app:tabRippleColor="@android:color/transparent"
            android:background="@android:color/transparent"/>

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>