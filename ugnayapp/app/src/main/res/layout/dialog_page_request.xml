<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    android:padding="20dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/poppins_semibold"
            android:text="Request Details"
            android:textColor="@color/brgy_yellow"
            android:textSize="12sp"
            android:textAllCaps="true"
            android:letterSpacing="0.1"
            android:layout_marginStart="4dp"
            android:layout_marginBottom="8dp"/>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cv_request_details"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="#0DFFFFFF"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp"
            app:strokeWidth="1dp"
            app:strokeColor="#1AFFFFFF"
            android:layout_marginBottom="24dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:id="@+id/tvRequestTypeInfo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/poppins_bold"
                    android:text="Barangay Clearance"
                    android:textColor="@color/text_white"
                    android:textSize="18sp"
                    android:layout_marginBottom="4dp"/>

                <TextView
                    android:id="@+id/tvRequestFullName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/poppins_regular"
                    android:text="Requested by Juan Dela Cruz"
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp"
                    android:layout_marginBottom="16dp"/>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#1AFFFFFF"
                    android:layout_marginBottom="16dp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Purpose of Request"
                    android:textColor="@color/brgy_blue"
                    android:textSize="11sp"
                    android:fontFamily="@font/poppins_semibold"
                    android:textAllCaps="true"
                    android:layout_marginBottom="4dp"/>

                <TextView
                    android:id="@+id/tvRequestPurposeInfo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/poppins_medium"
                    android:text="Employment Requirements and Personal Identification"
                    android:textColor="@color/text_white"
                    android:textSize="14sp"
                    android:lineSpacingMultiplier="1.2"
                    android:layout_marginBottom="16dp"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:src="@drawable/ic_news"
                        app:tint="@color/text_secondary"
                        android:alpha="0.7"/>

                    <TextView
                        android:id="@+id/tvRequestStartDate"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:fontFamily="@font/poppins_mediumitalic"
                        android:text="Submitted on Oct 24, 2023"
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp"/>
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnUpdateStatusDialog"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="Update Request Status"
            android:textColor="@color/text_white"
            android:fontFamily="@font/poppins_bold"
            app:cornerRadius="16dp"
            android:backgroundTint="@color/brgy_blue"
            app:icon="@drawable/ic_news"
            app:iconGravity="textStart"
            app:iconPadding="12dp"
            android:letterSpacing="0.05"
            android:elevation="4dp"/>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>