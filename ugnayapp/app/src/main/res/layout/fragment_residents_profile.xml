<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_dark">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:padding="24dp">

        <!-- TITLE -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="DIGITAL RESIDENT ID"
            android:textColor="@color/brgy_yellow"
            android:fontFamily="@font/poppins_semibold"
            android:textSize="18sp"
            android:layout_marginBottom="20dp"/>

        <!-- ID CARD WITH BORDER RADIUS -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="24dp"
            app:cardElevation="10dp"
            app:cardBackgroundColor="@color/card_background"
            android:layout_marginBottom="20dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="22dp"
                android:gravity="center_horizontal">

                <!-- PROFILE IMAGE -->
                <ImageView
                    android:id="@+id/img_profile"
                    android:layout_width="110dp"
                    android:layout_height="110dp"
                    android:src="@drawable/ic_person"
                    android:background="@color/brgy_yellow"
                    android:padding="10dp"/>

                <!-- NAME -->
                <TextView
                    android:id="@+id/tv_profile_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Resident Name"
                    android:textColor="@color/text_white"
                    android:fontFamily="@font/poppins_bold"
                    android:textSize="20sp"
                    android:layout_marginTop="12dp"/>

                <!-- USER ID -->
                <TextView
                    android:id="@+id/tv_profile_user_id"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="GUIN-0000-RES"
                    android:textColor="@color/brgy_yellow"
                    android:fontFamily="@font/poppins_medium"
                    android:layout_marginTop="4dp"/>

                <!-- EMAIL -->
                <TextView
                    android:id="@+id/tv_profile_email"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="email@example.com"
                    android:textColor="@color/text_secondary"
                    android:layout_marginTop="4dp"/>

                <!-- DIVIDER -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/text_secondary"
                    android:layout_marginTop="16dp"
                    android:layout_marginBottom="16dp"/>

                <!-- EXTRA DETAILS -->
                <TextView
                    android:id="@+id/tv_profile_gender"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Gender: -"
                    android:textColor="@color/text_white"
                    android:layout_marginBottom="4dp"/>

                <TextView
                    android:id="@+id/tv_profile_birthdate"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Birthdate: -"
                    android:textColor="@color/text_white"
                    android:layout_marginBottom="4dp"/>

                <TextView
                    android:id="@+id/tv_profile_contact"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Contact: -"
                    android:textColor="@color/text_white"
                    android:layout_marginBottom="4dp"/>

                <TextView
                    android:id="@+id/tv_profile_address"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Address: -"
                    android:textColor="@color/text_white"/>

            </LinearLayout>

        </androidx.cardview.widget.CardView>

        <!-- ACTIONS -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/text_secondary"
            android:layout_marginBottom="16dp"/>

        <Button
            android:id="@+id/btn_edit_profile"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:text="Account Settings"
            android:backgroundTint="@color/brgy_blue"
            android:textColor="@color/text_white"
            android:textAllCaps="false"
            android:fontFamily="@font/poppins_medium"
            android:layout_marginBottom="10dp"/>

        <Button
            android:id="@+id/btn_logout"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:text="Logout"
            android:backgroundTint="@color/brgy_red"
            android:textColor="@color/text_white"
            android:textAllCaps="false"
            android:fontFamily="@font/poppins_semibold"/>

    </LinearLayout>

</ScrollView>