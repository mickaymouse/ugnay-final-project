<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_dark">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            android:fontFamily="@font/poppins_bold"
            android:text="Official Registration"
            android:textColor="@color/text_white"
            android:textSize="24sp" />

        <FrameLayout
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:layout_gravity="center"
            android:layout_marginBottom="24dp">

            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/iv_official_register_profile"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:src="@drawable/ic_profile_placeholder"
                app:shapeAppearanceOverlay="@style/ShapeAppearance.MaterialComponents.LargeComponent"
                app:strokeColor="@color/brgy_yellow"
                app:strokeWidth="2dp" />

            <com.google.android.material.floatingactionbutton.FloatingActionButton
                android:id="@+id/fab_official_upload_photo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|end"
                android:src="@android:drawable/ic_menu_camera"
                app:backgroundTint="@color/brgy_yellow"
                app:fabSize="mini"
                app:tint="@color/background_dark" />
        </FrameLayout>

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:hint="First Name"
            android:textColorHint="@color/text_white"
            app:boxStrokeColor="@color/brgy_yellow"
            app:hintTextColor="@color/brgy_yellow">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/et_official_firstname"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/poppins_regular"
                android:textColor="@color/text_white" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:hint="Middle Name"
            android:textColorHint="@color/text_white"
            app:boxStrokeColor="@color/brgy_yellow"
            app:hintTextColor="@color/brgy_yellow">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/et_official_middlename"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/poppins_regular"
                android:textColor="@color/text_white" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:hint="Last Name"
            android:textColorHint="@color/text_white"
            app:boxStrokeColor="@color/brgy_yellow"
            app:hintTextColor="@color/brgy_yellow">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/et_official_lastname"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/poppins_regular"
                android:textColor="@color/text_white" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:hint="Suffix (if applicable)"
            android:textColorHint="@color/text_white"
            app:boxStrokeColor="@color/brgy_yellow"
            app:hintTextColor="@color/brgy_yellow">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/et_official_suffix"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/poppins_regular"
                android:textColor="@color/text_white" />
        </com.google.android.material.textfield.TextInputLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:layout_marginBottom="16dp"
                android:layout_weight="1"
                android:hint="Sex / Gender"
                android:textColorHint="@color/text_white"
                app:boxStrokeColor="@color/brgy_yellow"
                app:hintTextColor="@color/brgy_yellow">

                <AutoCompleteTextView
                    android:id="@+id/actv_official_gender"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/poppins_regular"
                    android:inputType="none"
                    android:textColor="@color/text_white" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_marginBottom="16dp"
                android:layout_weight="1"
                android:hint="Civil Status"
                android:textColorHint="@color/text_white"
                app:boxStrokeColor="@color/brgy_yellow"
                app:hintTextColor="@color/brgy_yellow">

                <AutoCompleteTextView
                    android:id="@+id/actv_official_civil_status"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/poppins_regular"
                    android:inputType="none"
                    android:textColor="@color/text_white" />
            </com.google.android.material.textfield.TextInputLayout>
        </LinearLayout>

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:hint="Date of Birth"
            android:textColorHint="@color/text_white"
            app:boxStrokeColor="@color/brgy_yellow"
            app:hintTextColor="@color/brgy_yellow">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/et_official_dob"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:focusable="false"
                android:fontFamily="@font/poppins_regular"
                android:textColor="@color/text_white" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:hint="Place of Birth"
            android:textColorHint="@color/text_white"
            app:boxStrokeColor="@color/brgy_yellow"
            app:hintTextColor="@color/brgy_yellow">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/et_official_pob"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/poppins_regular"
                android:textColor="@color/text_white" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            android:hint="Nationality / Citizenship"
            android:textColorHint="@color/text_white"
            app:boxStrokeColor="@color/brgy_yellow"
            app:hintTextColor="@color/brgy_yellow">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/et_official_nationality"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/poppins_regular"
                android:textColor="@color/text_white" />
        </com.google.android.material.textfield.TextInputLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:fontFamily="@font/poppins_semibold"
            android:text="Complete Address"
            android:textColor="@color/brgy_yellow"
            android:textSize="18sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:layout_marginBottom="16dp"
                android:layout_weight="1"
                android:hint="Purok"
                android:textColorHint="@color/text_white"
                app:boxStrokeColor="@color/brgy_yellow"
                app:hintTextColor="@color/brgy_yellow">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/et_official_purok"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/poppins_regular"
                    android:textColor="@color/text_white" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_marginBottom="16dp"
                android:layout_weight="1"
                android:hint="Barangay"
                android:textColorHint="@color/text_white"
                app:boxStrokeColor="@color/brgy_yellow"
                app:hintTextColor="@color/brgy_yellow">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/et_official_barangay"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/poppins_regular"
                    android:textColor="@color/text_white" />
            </com.google.android.material.textfield.TextInputLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:layout_marginBottom="16dp"
                android:layout_weight="1"
                android:hint="City / Municipality"
                android:textColorHint="@color/text_white"
                app:boxStrokeColor="@color/brgy_yellow"
                app:hintTextColor="@color/brgy_yellow">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/et_official_municipality"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/poppins_regular"
                    android:textColor="@color/text_white" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_marginBottom="16dp"
                android:layout_weight="1"
                android:hint="Province"
                android:textColorHint="@color/text_white"
                app:boxStrokeColor="@color/brgy_yellow"
                app:hintTextColor="@color/brgy_yellow">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/et_official_province"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/poppins_regular"
                    android:textColor="@color/text_white" />
            </com.google.android.material.textfield.TextInputLayout>
        </LinearLayout>

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            android:hint="Zip Code"
            android:textColorHint="@color/text_white"
            app:boxStrokeColor="@color/brgy_yellow"
            app:hintTextColor="@color/brgy_yellow">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/et_official_zip"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/poppins_regular"
                android:inputType="number"
                android:textColor="@color/text_white" />
        </com.google.android.material.textfield.TextInputLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:fontFamily="@font/poppins_semibold"
            android:text="Contact Information"
            android:textColor="@color/brgy_yellow"
            android:textSize="18sp" />

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:hint="Mobile Number"
            android:textColorHint="@color/text_white"
            app:boxStrokeColor="@color/brgy_yellow"
            app:hintTextColor="@color/brgy_yellow">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/et_official_contact"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/poppins_regular"
                android:inputType="phone"
                android:textColor="@color/text_white" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            android:hint="Email Address"
            android:textColorHint="@color/text_white"
            app:boxStrokeColor="@color/brgy_yellow"
            app:hintTextColor="@color/brgy_yellow"
            app:suffixText="@guintas.ph"
            app:suffixTextColor="@color/text_white">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/et_official_email"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/poppins_regular"
                android:inputType="textEmailAddress"
                android:textColor="@color/text_white" />
        </com.google.android.material.textfield.TextInputLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:fontFamily="@font/poppins_semibold"
            android:text="Office &amp; Term"
            android:textColor="@color/brgy_yellow"
            android:textSize="18sp" />

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:hint="Position"
            android:textColorHint="@color/text_white"
            app:boxStrokeColor="@color/brgy_yellow"
            app:hintTextColor="@color/brgy_yellow">

            <AutoCompleteTextView
                android:id="@+id/actv_official_position"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/poppins_regular"
                android:inputType="none"
                android:textColor="@color/text_white" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:hint="Committee Assignment"
            android:textColorHint="@color/text_white"
            app:boxStrokeColor="@color/brgy_yellow"
            app:hintTextColor="@color/brgy_yellow">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/et_official_committee"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/poppins_regular"
                android:inputType="textCapWords"
                android:textColor="@color/text_white" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:hint="Date Elected / Appointed"
            android:textColorHint="@color/text_white"
            app:boxStrokeColor="@color/brgy_yellow"
            app:hintTextColor="@color/brgy_yellow">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/et_official_date_elected"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:focusable="false"
                android:fontFamily="@font/poppins_regular"
                android:textColor="@color/text_white" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:hint="Team Start Date"
            android:textColorHint="@color/text_white"
            app:boxStrokeColor="@color/brgy_yellow"
            app:hintTextColor="@color/brgy_yellow">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/et_official_team_start"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:focusable="false"
                android:fontFamily="@font/poppins_regular"
                android:textColor="@color/text_white" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:hint="Term End Date"
            android:textColorHint="@color/text_white"
            app:boxStrokeColor="@color/brgy_yellow"
            app:hintTextColor="@color/brgy_yellow">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/et_official_term_end"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:focusable="false"
                android:fontFamily="@font/poppins_regular"
                android:textColor="@color/text_white" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            android:hint="Status"
            android:textColorHint="@color/text_white"
            app:boxStrokeColor="@color/brgy_yellow"
            app:hintTextColor="@color/brgy_yellow">

            <AutoCompleteTextView
                android:id="@+id/actv_official_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/poppins_regular"
                android:inputType="none"
                android:textColor="@color/text_white" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:hint="Password"
            android:textColorHint="@color/text_white"
            app:boxStrokeColor="@color/brgy_yellow"
            app:hintTextColor="@color/brgy_yellow"
            app:passwordToggleEnabled="true"
            app:passwordToggleTint="@color/text_white">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/et_official_password"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/poppins_regular"
                android:inputType="textPassword"
                android:textColor="@color/text_white" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="32dp"
            android:hint="Confirm Password"
            android:textColorHint="@color/text_white"
            app:boxStrokeColor="@color/brgy_yellow"
            app:hintTextColor="@color/brgy_yellow"
            app:passwordToggleEnabled="true"
            app:passwordToggleTint="@color/text_white">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/et_official_confirm_password"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/poppins_regular"
                android:inputType="textPassword"
                android:textColor="@color/text_white" />
        </com.google.android.material.textfield.TextInputLayout>

        <Button
            android:id="@+id/btn_official_register"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:backgroundTint="@color/brgy_blue"
            android:fontFamily="@font/poppins_semibold"
            android:text="Register"
            android:textAllCaps="false"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/tv_official_go_to_login"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginTop="24dp"
            android:fontFamily="@font/poppins_regular"
            android:text="Already have an account? Login"
            android:textColor="@color/brgy_yellow" />

    </LinearLayout>
</ScrollView>
